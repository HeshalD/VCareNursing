# ============================================================
#  VCareNursing — Backend environment variables
#  Copy to backend/.env on the server and fill in real values.
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
PORT=5000
JWT_SECRET=change-this-to-a-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=7d
# Public origin of the frontend (used for CORS). Same-origin /api setups
# don't strictly need this, but set it for safety.
CLIENT_URL=https://yourdomain.lk

# ── Database (AWS RDS PostgreSQL) ────────────────────────────
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=vcarenursing
DB_USER=vcareuser
DB_PASSWORD=your-db-password

# ── AWS S3 (file storage — replaces Cloudinary) ──────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-iam-secret-access-key
AWS_S3_BUCKET_NAME=vcarenursing-files

# ── Email ────────────────────────────────────────────────────
# SMTP (nodemailer) — used by utils/email.js
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=VCare Nursing <your-email@gmail.com>
# Resend (utils/resendEmail.js) — set if you use Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# SendGrid (utils/sendGridEmail.js) — set if you use SendGrid
SENDGRID_API_KEY=

# ── WhatsApp / SMS ───────────────────────────────────────────
# Meta WhatsApp Cloud API (utils/metaWhatsapp.js)
META_WHATSAPP_TOKEN=
META_WA_PHONE_NUMBER_ID=
# Twilio (utils/whatsapp.js, utils/sms.js)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
# SMSAPI.lk (utils/sms.js)
SMSAPI_LK_API_KEY=
SMSAPI_LK_SENDER_ID=

# ── Migration ────────────────────────────────────────────────
# Set to 'false' to skip the auto-migration that runs on production boot.
AUTO_MIGRATE=true
